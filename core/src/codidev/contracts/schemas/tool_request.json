{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codidev.local/schemas/tool_request.json",
  "title": "ToolRequest",
  "description": "Requête d'outil soumise au Tool Router, qui est une frontière de sécurité (04_EXECUTION/01_TOOL_ROUTER.md). La requête porte le contexte d'autorisation nécessaire pour que la politique puisse décider sans dépendre du texte du LLM.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "action", "identity", "tenant_id", "resource_scope", "created_at"],
  "properties": {
    "request_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "action": { "$ref": "https://codidev.local/schemas/action.json" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_type"],
      "properties": {
        "actor_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actor_type": { "type": "string", "enum": ["HUMAN", "AGENT", "SYSTEM"] },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["PLATFORM_ADMIN", "TENANT_OWNER", "TENANT_ADMIN", "MEMBER", "VIEWER"]
          },
          "uniqueItems": true
        }
      }
    },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "project_id": { "type": ["string", "null"], "maxLength": 128 },
    "resource_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 },
      "description": "Ressources explicitement couvertes par la requête. Toute ressource hors périmètre est refusée."
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
