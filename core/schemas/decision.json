{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codidev.local/schemas/decision.json",
  "title": "DecisionRecord",
  "description": "Décision structurante (03_AGENT_CORE/03_DECISION_ENGINE.md) : intention, exigences, contraintes, sources, options examinées, option retenue, risques, permissions requises, résultat de politique et plan de vérification. Le motif est exposable ; le raisonnement privé n'est pas un artefact du produit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "intent",
    "options",
    "risks",
    "required_permissions",
    "policy_outcome",
    "verification_plan",
    "decided_at"
  ],
  "properties": {
    "decision_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "intent": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "requirements": { "type": "array", "items": { "type": "string", "maxLength": 2000 } },
    "constraints": { "type": "array", "items": { "type": "string", "maxLength": 2000 } },
    "sources": {
      "type": "array",
      "items": { "type": "string", "maxLength": 2048 },
      "description": "Ce sur quoi la décision s'appuie. Une source absente est un point ouvert."
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option_id", "description", "risk_class", "reversible", "selected"],
        "properties": {
          "option_id": { "type": "string", "minLength": 4, "maxLength": 128 },
          "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "expected_outcome": { "type": ["string", "null"], "maxLength": 2000 },
          "risk_class": {
            "type": "string",
            "enum": [
              "READ",
              "LOW_WRITE",
              "WRITE",
              "SENSITIVE_WRITE",
              "DESTRUCTIVE",
              "EXTERNAL_SIDE_EFFECT",
              "DEPLOYMENT",
              "SECURITY_SENSITIVE"
            ]
          },
          "reversible": { "type": "boolean" },
          "selected": { "type": "boolean" },
          "rejected_because": {
            "type": ["string", "null"],
            "maxLength": 2000,
            "description": "Motif de rejet d'une option non retenue. Une option écartée est expliquée, jamais tue."
          }
        }
      }
    },
    "selected_option_id": { "type": ["string", "null"], "maxLength": 128 },
    "rationale": {
      "type": ["string", "null"],
      "maxLength": 4000,
      "description": "Motif exposable de la sélection. Jamais de chain-of-thought privé."
    },
    "risks": { "type": "array", "items": { "type": "string", "maxLength": 2000 } },
    "required_permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["READ", "LOW_WRITE", "WRITE", "SENSITIVE_WRITE", "DESTRUCTIVE", "EXTERNAL_SIDE_EFFECT", "DEPLOYMENT", "SECURITY_SENSITIVE"]
      },
      "uniqueItems": true
    },
    "policy_outcome": { "type": "string", "enum": ["ALLOW", "DENY", "REQUIRE_APPROVAL"] },
    "policy_id": { "type": ["string", "null"], "maxLength": 128 },
    "obligations": {
      "type": "array",
      "items": { "type": "string", "maxLength": 500 },
      "description": "Conditions à satisfaire avant exécution (ex. 'approval:human-gate')."
    },
    "verification_plan": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 },
      "description": "Comment la décision sera vérifiée. Sans plan de vérification, une décision n'est pas vérifiable."
    },
    "plan_id": { "type": ["string", "null"], "maxLength": 128 },
    "tenant_id": { "type": ["string", "null"], "maxLength": 128 },
    "project_id": { "type": ["string", "null"], "maxLength": 128 },
    "decided_at": { "type": "string", "format": "date-time" }
  }
}
