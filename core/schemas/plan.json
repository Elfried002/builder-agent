{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codidev.local/schemas/plan.json",
  "title": "Plan",
  "description": "Plan d'ingénierie (03_AGENT_CORE/02_PLANNER.md) : objectif, exigences, hypothèses, dépendances, étapes ordonnées, sorties attendues, risques, permissions, critères de vérification et rollback. Un plan est versionné : une révision produit une nouvelle version qui déclare celle qu'elle remplace, sans réécrire l'historique.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "objective",
    "version",
    "status",
    "steps",
    "verification_criteria",
    "created_at"
  ],
  "properties": {
    "plan_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "version": { "type": "integer", "minimum": 1 },
    "supersedes": {
      "type": ["string", "null"],
      "maxLength": 128,
      "description": "Plan remplacé par cette version. Aucune version n'est supprimée."
    },
    "status": { "type": "string", "enum": ["DRAFT", "PROPOSED", "APPROVED", "SUPERSEDED", "ABANDONED"] },
    "requirements": { "type": "array", "items": { "type": "string", "maxLength": 2000 } },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "maxLength": 2000 },
      "description": "Hypothèses explicites. Une hypothèse n'est jamais présentée comme un fait."
    },
    "dependencies": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "order", "description", "expected_output", "risk_class", "verification"],
        "properties": {
          "step_id": { "type": "string", "minLength": 4, "maxLength": 128 },
          "order": { "type": "integer", "minimum": 1 },
          "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "expected_output": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "risk_class": {
            "type": "string",
            "enum": [
              "READ",
              "LOW_WRITE",
              "WRITE",
              "SENSITIVE_WRITE",
              "DESTRUCTIVE",
              "EXTERNAL_SIDE_EFFECT",
              "DEPLOYMENT",
              "SECURITY_SENSITIVE"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "minLength": 4, "maxLength": 128 },
            "description": "Identifiants d'étapes antérieures dont dépend cette étape."
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "description": "Critères qui décideront si l'étape est vérifiée. Sans critère, une étape n'est jamais vérifiable."
          },
          "rollback": {
            "type": ["string", "null"],
            "maxLength": 2000,
            "description": "Chemin de retour arrière. Obligatoire pour toute étape destructive ou de déploiement."
          }
        }
      }
    },
    "risks": { "type": "array", "items": { "type": "string", "maxLength": 2000 } },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["READ", "LOW_WRITE", "WRITE", "SENSITIVE_WRITE", "DESTRUCTIVE", "EXTERNAL_SIDE_EFFECT", "DEPLOYMENT", "SECURITY_SENSITIVE"]
      },
      "uniqueItems": true,
      "description": "Union des classes de risque des étapes : c'est ce que le plan exige comme droits."
    },
    "verification_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 },
      "description": "Critères au niveau du plan : ce qui décidera que l'objectif est atteint."
    },
    "rollback": { "type": ["string", "null"], "maxLength": 4000 },
    "tenant_id": { "type": ["string", "null"], "maxLength": 128 },
    "project_id": { "type": ["string", "null"], "maxLength": 128 },
    "task_id": { "type": ["string", "null"], "maxLength": 128 },
    "intent_id": { "type": ["string", "null"], "maxLength": 128 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
